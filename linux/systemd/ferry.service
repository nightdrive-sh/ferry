# Ferry's server: the page and the API on 127.0.0.1 only, which tailscale serve publishes on the tailnet. `ferry enable`
# copies this to ~/.config/systemd/user with ExecStart naming its own copy of ferry, and starts it.
# With the user's session rather than the desktop's, so it also runs on a computer without one: desktop_env() finds the
# desktop when the clipboard or a notification needs it.
[Unit]
Description=Ferry (a mailbox between your devices over Tailscale)

[Service]
ExecStart=%h/.local/bin/ferry run
Restart=on-failure
RestartSec=3

# Hardening: what a server reached from the tailnet doesn't need, so a flaw in it can't use it either. Only what a
# user's own manager sets without a namespace (those need unprivileged user namespaces, which some distributions
# restrict), and only what doesn't break an ordinary app, since everything here is inherited by what the server
# starts: the hook (~/.config/ferry/hook), and the app xdg-open opens a received file in. So no PrivateTmp (X11's
# socket is in /tmp, for xclip), no ProtectHome (files go to Downloads), no MemoryDenyWriteExecute (a browser's JIT),
# no RestrictNamespaces (Flatpak's and browsers' sandboxes).
# No setuid or file capabilities (sudo, pkexec): a compromised server can't ride a cached sudo
NoNewPrivileges=yes
RestrictSUIDSGID=yes
# Its own HTTP and the tailnet (IP), D-Bus, Wayland, X11 and Tailscale's socket (Unix), and the addresses
# getaddrinfo asks for (netlink)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=default.target
