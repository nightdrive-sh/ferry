#!/usr/bin/python3
"""Ferry: a mailbox between your devices, over Tailscale. This is a Linux computer's side of it.

The command and the server are the ferry package beside bin/ (ferry/): its usage is in
ferry/cli.py, how it works in ferry/__init__.py."""
import os
import sys

# The package beside bin/: ~/.local/bin/ferry is a link to bin/ferry, so the real path
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from ferry import cli  # noqa: E402


if __name__ == "__main__":
    sys.exit(cli.main())
